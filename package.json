{
  "name": "softpet",
  "version": "0.0.0",
  "private": true,
  "description": "Pet de desktop: um bichinho que vive na sua tela.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @softpet/desktop",
    "build": "npm run build --workspace @softpet/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dist": "npm run dist --workspace @softpet/desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
